# Octopus standalone development configuration.
# Self-hosted production deployments use deploy/.env.example and deploy/deploy.sh.
# SaaS production values are generated by Squid/deploy.

SERVER_PORT=8080
GIN_MODE=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
DB_DSN=host=localhost user=octopus password=octopus dbname=octopus port=5432 sslmode=disable TimeZone=Asia/Shanghai

OUTPUT_DIR=/mnt/data/output
TEMPLATE_DIR=/mnt/data/templates
ARCHIVE_DIR=/mnt/data/archive
STORAGE_LOCAL_DIR=/mnt/data/uploads
DEFAULT_EXECUTOR=local
MINIWDL_PATH=miniwdl

SEPIIDA_ENABLED=false
SEPIIDA_URL=http://localhost:9090
SEPIIDA_QUERY_KEY=
PARQUET_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_COOKIE_SECURE=false
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=admin@octopus.local
DEFAULT_ADMIN_PASSWORD=change-me-before-use

# Optional OpenAI-compatible proxy.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# SchemaBio self-hosted environment example.
# Run bash ./deploy.sh init from this directory to create .env and generate
# credentials in .generated/runtime.env. Edit .env before running:
# sudo bash ./deploy.sh install
# Keep both files private. Keep generated credentials stable after first startup.
# Use Bash-compatible assignments because deploy.sh also sources these files.

# Set the actual data directory and the workflow checkout.
DATA_ROOT=/mnt/data
WORKFLOW_HOST_DIR=/mnt/data/schema-germline
# Leave empty for http://localhost at YIJIAN_PORT. Set an HTTPS origin only
# when deploying behind a reverse proxy.
PUBLIC_ORIGIN=
INSTALL_ROOT=/opt/schemabio

# The installer expects .generated/octopus and discovers MiniWDL and the
# Sepiida Agent on the host PATH. Set these only to use a different location.
# OCTOPUS_BINARY=/absolute/path/to/octopus
# SEPIIDA_AGENT_BINARY=/absolute/path/to/sepiida-agent
# MINIWDL_PATH=/absolute/path/to/miniwdl

# OPTIONAL: initial administrator email and default interface language.
# The administrator password is generated by deploy.sh init.
DEFAULT_ADMIN_EMAIL=admin@schemabio.local
# Available locales: zh-CN, zh-Hant, en, es-419.
YIJIAN_DEFAULT_LOCALE=zh-CN

# OPTIONAL: change host ports if they are already in use.
# Compose binds them to loopback. Internal container ports stay fixed.
OCTOPUS_PORT=8080
SEPIIDA_PORT=9090
SEPILENS_PORT=18081
POSTGRES_PORT=54320
YIJIAN_PORT=3000

# Optional: set the absolute path to a local hg19 FASTA for IGV.
IGV_HG19_FASTA_PATH=
# Optional override. Leave empty to use Octopus's default (enabled).
PARQUET_ENABLED=

# Keep cleanup disabled unless you intend to delete archived or expired data.
ARCHIVE_CLEANUP=false
DATA_RETENTION_DAYS=0
UPLOAD_MAX_SIZE_MB=0
# Optional authenticated IGV reference proxy, e.g. https://your-octopus-host/api/v1.
IGV_REFERENCE_PROXY_BASE_URL=
# SEPILENS OVERRIDE ONLY (sepilens.override.yaml). Keep off pending acceptance.
AI_ASSISTANCE_EVIDENCE_CHAIN_ENABLED=false

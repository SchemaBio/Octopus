# SchemaBio self-hosted environment example.
# Run bash ./deploy.sh init from this directory to create .env and generate
# credentials in .generated/runtime.env. Edit .env and pass both files:
# docker compose --env-file .env --env-file .generated/runtime.env up -d --no-build --pull never
# Keep both files private. Keep generated credentials stable after first startup.
# Use Bash-compatible assignments because deploy.sh also sources these files.

# CHECK BEFORE STARTING: absolute paths as seen from WSL.
# Change these two together if your data is outside E:\SchemaBio.
# DATA_ROOT holds schema-germline/, output/, archive/, uploads/ and cache/parquet/.
# The reference directory must be under DATA_ROOT and contain manifest.json.
DATA_ROOT=/mnt/e/SchemaBio
ASSESSMENT_REFERENCE_DIR=/mnt/e/SchemaBio/database/phenotype-reference/HPO-20260901-HGNC-20261013-ClinGen-20261007-v1

# OPTIONAL: initial administrator email and default interface language.
# The administrator password is generated by deploy.sh init.
DEFAULT_ADMIN_EMAIL=admin@schemabio.local
# Available locales: zh-CN, zh-Hant, en, es-419.
YIJIAN_DEFAULT_LOCALE=zh-CN

# OPTIONAL: change host ports if they are already in use.
# Compose binds them to loopback. Internal container ports stay fixed.
OCTOPUS_PORT=8080
SEPIIDA_PORT=9090
YIJIAN_PORT=3000

# OPTIONAL: absolute path to a local hg19 FASTA under DATA_ROOT. Leave empty
# unless you have a local reference to use for IGV.
IGV_HG19_FASTA_PATH=
# Optional override. Leave empty to use Octopus's default (enabled).
PARQUET_ENABLED=
# Set only when Octopus has a compatible miniwdl runtime at this container path.
# The stock Octopus image does not include miniwdl. See README before running jobs.
MINIWDL_CONTAINER_PATH=/opt/miniwdl/bin/miniwdl

# HOST SYSTEMD DEPLOYMENT ONLY (deploy.sh install and docker-compose.host.yml).
# Replace PUBLIC_ORIGIN with your HTTPS origin and set host workflow paths.
PUBLIC_ORIGIN=https://schemabio.example.com
WORKFLOW_HOST_DIR=./workflows
# Leave blank to discover miniwdl on the host PATH.
MINIWDL_PATH=
INSTALL_ROOT=/opt/schemabio
# Host Octopus and Sepiida connect to PostgreSQL through this loopback port.
POSTGRES_PORT=54320
SUPPORT_EMAIL=support@schemabio.com
# Keep cleanup disabled unless you intend to delete archived or expired data.
ARCHIVE_CLEANUP=false
DATA_RETENTION_DAYS=0
UPLOAD_MAX_SIZE_MB=0
# Optional authenticated IGV reference proxy, e.g. https://your-octopus-host/api/v1.
IGV_REFERENCE_PROXY_BASE_URL=
# Build-time option for YiJian in the host deployment.
NEXT_PUBLIC_ASSESSMENT_OPTIMIZED=false

# SEPILENS OVERRIDE ONLY (sepilens.override.yaml). Keep off pending acceptance.
AI_ASSISTANCE_EVIDENCE_CHAIN_ENABLED=false

# SchemaBio self-hosted deployment
# Copy to .env. PUBLIC_ORIGIN is the only required setting.
# Values use Bash .env syntax because deploy.sh loads this file directly.

PUBLIC_ORIGIN=https://schemabio.example.com

# Usually no changes are needed below this line.
WORKFLOW_HOST_DIR=./workflows
MINIWDL_PATH=
INSTALL_ROOT=/opt/schemabio
DATA_ROOT=/var/lib/schemabio
DEFAULT_ADMIN_EMAIL=admin@schemabio.local
SUPPORT_EMAIL=support@schemabio.com

POSTGRES_PORT=54320
OCTOPUS_PORT=8080
SEPIIDA_PORT=9090
YIJIAN_PORT=3000

ARCHIVE_CLEANUP=false
UPLOAD_MAX_SIZE_MB=0
DATA_RETENTION_DAYS=0
PARQUET_ENABLED=true

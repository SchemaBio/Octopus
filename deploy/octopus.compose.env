# Octopus environment for the local Compose stack. Docker Compose expands
# values from .env and .generated/runtime.env. Put site-specific values there.

# The image defaults to release mode, which requires secure cookies.
# Local loopback HTTP uses debug mode and the default non-secure cookies.
GIN_MODE=debug
ALLOW_INSECURE_DEV="true"
CORS_ALLOWED_ORIGINS=http://localhost:${YIJIAN_PORT:-3000},http://127.0.0.1:${YIJIAN_PORT:-3000}
DB_DSN=host=postgres user=octopus password=${OCTOPUS_DB_PASSWORD} dbname=octopus port=5432 sslmode=disable TimeZone=Asia/Shanghai
OUTPUT_DIR=${DATA_ROOT}/output
ARCHIVE_DIR=${DATA_ROOT}/archive
STORAGE_LOCAL_DIR=${DATA_ROOT}/uploads
TEMPLATE_DIR=${DATA_ROOT}/schema-germline
MINIWDL_PATH=${MINIWDL_CONTAINER_PATH:-/opt/miniwdl/bin/miniwdl}
MINIWDL__DOCKER_SWARM__AUTO_INIT="true"
SEPIIDA_URL=http://sepiida-server:9090
SEPIIDA_QUERY_KEY=${SEPIIDA_QUERY_KEY:?run deploy.sh init}
IGV_HG19_FASTA_PATH=${IGV_HG19_FASTA_PATH:-}
PARQUET_ENABLED=${PARQUET_ENABLED:-}
ASSESSMENT_REFERENCE_DIR=${ASSESSMENT_REFERENCE_DIR}
ASSESSMENT_SUPPLEMENT_MANIFEST=${ASSESSMENT_REFERENCE_DIR}/manifest.json
PARQUET_CACHE_DIR=${DATA_ROOT}/cache/parquet
JWT_SECRET=${OCTOPUS_JWT_SECRET:?run deploy.sh init}
CREATE_DEFAULT_ADMIN="true"
DEFAULT_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL:-admin@schemabio.local}
DEFAULT_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD:?run deploy.sh init}
# Use the separate SepiLens service instead of the loopback default.
AI_ASSISTANCE_BASE_URL=http://sepilens:8080
AI_ASSISTANCE_TOKEN=${AI_ASSISTANCE_TOKEN:?run deploy.sh init}
AI_ASSISTANCE_MASTER_KEY=${AI_ASSISTANCE_MASTER_KEY:?run deploy.sh init}
